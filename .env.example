# Copy to .env and set non-empty secrets before running Docker Compose.
# Keep this database name in sync with sql/schema.sql.
MYSQL_DATABASE=career_pilot_ai
MYSQL_USER=career_pilot
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
PGVECTOR_DATABASE=career_pilot_vector
PGVECTOR_USERNAME=career_pilot
PGVECTOR_PASSWORD=
# Compose uses postgres-vector:5432; local backend defaults to localhost:5432.
PGVECTOR_HOST=localhost
PGVECTOR_PORT=5432
# Default text-embedding-3-small returns 1536 values. Change with the embedding model.
PGVECTOR_DIMENSIONS=1536
OPENAI_API_KEY=
JWT_SECRET=

# Only the frontend is published, on the local machine by default.
WEB_HOST=127.0.0.1
WEB_PORT=8088
SPRING_PROFILES_ACTIVE=prod
CHAT_MEMORY_MAX_MESSAGES=20
AI_CHAT_RATE_LIMIT=20
AI_UPLOAD_RATE_LIMIT=5

# Optional model and profile overrides. Current application.yml supplies these defaults.
OPENAI_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
